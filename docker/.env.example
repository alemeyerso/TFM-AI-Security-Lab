# ============================================================
# AI Security Lab — Configuración
# ============================================================
# Copia este fichero como docker/.env y rellena tus valores.
# NUNCA subas docker/.env al repo (ya está en .gitignore).
# ============================================================

# ─── JUPYTER ─────────────────────────────────────────────────
# Token de acceso local para Jupyter. Usa un valor propio y no lo subas al repo.
# Déjalo vacío aquí: docker compose se niega a arrancar hasta que pongas un
# valor propio (p. ej. la salida de: python -c "import secrets; print(secrets.token_hex(32))").
JUPYTER_TOKEN=

# ─── GITHUB SYNC (botón "Compartir Resultados") ─────────────
# Crea un token en: https://github.com/settings/tokens/new
#   → Selecciona: repo (acceso completo)
#   → Expiration: 90 days (o "No expiration" para el TFM)
# Pega el token aquí:
ENABLE_GITHUB_SYNC=false

# ─── PANEL LIVE ──────────────────────────────────────────────
# true = añade una instrucción defensiva (spotlighting) a los prompts indirectos.
# false (por defecto) = condición de ataque sin defensa, como en el canario.
INDIRECT_SPOTLIGHTING=false

# true = la defensa del panel live RETIENE las respuestas clasificadas como
# "dangerous" por el OutputValidator (bloqueo real de salida).
# false (por defecto) = la capa de salida solo genera una alerta y la
# respuesta se entrega sin modificar.
DEFENSE_BLOCK_DANGEROUS_OUTPUT=false

# true = modo estricto de la defensa live: una sola señal débil marca la entrada
# como sospechosa, el umbral de bloqueo de entrada baja a 3.0 y el de salida
# "dangerous" a 4.0. false (por defecto) = umbrales 5.0 / 5.0.
DEFENSE_STRICT_MODE=false

# Revisiones de payload opcionales. Vacío = revisión 1 (estímulo por defecto).
# Ejemplo: PAYLOAD_REVISIONS=indirect_004=2  (corrige el mojibake; ver README §5)
PAYLOAD_REVISIONS=

# Orígenes permitidos por CORS en la API (ajustar si cambias DASHBOARD_PORT)
CORS_ORIGINS=http://localhost:8080,http://127.0.0.1:8080

# Token de GitHub (solo si ENABLE_GITHUB_SYNC=true). Nunca lo subas al repo.
GITHUB_TOKEN=

# Repositorio del equipo (no cambiar salvo que hagáis un fork)
GITHUB_REPO=alemeyerso/TFM-AI-Security-Lab
GITHUB_BRANCH=main

# ─── OLLAMA ──────────────────────────────────────────────────
# No cambiar — apunta al Ollama que corre en tu máquina host
OLLAMA_HOST=http://host.docker.internal:11434

# Modelo por defecto para ataques automáticos
DEFAULT_MODEL=gemma4:e2b

# Contexto del modelo (necesario para Gemma 4)
NUM_CTX=127000

# ─── PUERTOS ─────────────────────────────────────────────────
DASHBOARD_PORT=8080
