# =============================================================
# AI Security Lab — Variables de Entorno
# Copia este archivo a .env y ajusta los valores
# NUNCA subas el archivo .env a Git (está en .gitignore)
# =============================================================

# ── OLLAMA ────────────────────────────────────────────────────
# Host donde corre Ollama
# Windows/Mac Docker: host.docker.internal
# Linux Docker: 172.17.0.1 (IP del bridge, verificar con `ip route`)
# Sin Docker: localhost
OLLAMA_HOST=host.docker.internal:11434

# ── MODELOS ───────────────────────────────────────────────────
# Modelo por defecto para evaluación
DEFAULT_MODEL=gemma4:e2b

# Ventana de contexto (IMPORTANTE: Gemma 4 soporta hasta 128K)
# El fix de Juan: usar 127000 en lugar del default pequeño
NUM_CTX=127000

# Temperatura del modelo (0.0 = determinista, 1.0 = creativo)
TEMPERATURE=0.1

# ── DIRECTORIOS ───────────────────────────────────────────────
# Directorio donde se guardan los resultados JSON
RESULTS_DIR=/lab/lab/results

# Directorio de payloads de ataque
PAYLOADS_DIR=/lab/lab/payloads

# Directorio de logs
LOGS_DIR=/lab/lab/logs

# ── LABORATORIO ───────────────────────────────────────────────
# Timeout por test en segundos
TEST_TIMEOUT=60

# Número máximo de tests en paralelo
MAX_CONCURRENT=1

# Número de reintentos si el modelo no responde
MAX_RETRIES=3

# ── LOGGING ───────────────────────────────────────────────────
# Nivel de logging: DEBUG, INFO, WARNING, ERROR
LOG_LEVEL=INFO

# ── DASHBOARD ─────────────────────────────────────────────────
# Puerto del dashboard (cuando se usa Docker Compose)
DASHBOARD_PORT=8080
